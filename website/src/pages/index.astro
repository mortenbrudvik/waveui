---
/**
 * Placeholder start page of the docs app, in the app shell, so the shell can be seen and measured
 * while the pages are written; the component pages and the index replace it (plan, Task 10).
 */
import AppLayout from '../layouts/AppLayout.astro';
import { getLibraryVersion } from '../docs/sizes';
---

<AppLayout title="Welcome" status={{ version: getLibraryVersion() }}>
  <div class="flex flex-col gap-3 p-6">
    <h1 class="m-0 text-wave-title-2">WaveUI docs</h1>
    <p class="m-0 max-w-prose text-wave-body-1">
      The documentation of WaveUI's 80 components. Choose a component in the navigation.
    </p>
  </div>
</AppLayout>
