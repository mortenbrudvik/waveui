---
/**
 * `/waveui/docs/theming`: the README's theming sections (themes and direction, brand colors and
 * `WaveProvider tokens`, customizing tokens; `src/docs/guides.ts`), rendered at build time, and a
 * link to its table of color tokens on GitHub.
 */
import AppLayout from '../layouts/AppLayout.astro';
import GuideArticle from '../docs/GuideArticle.astro';
import { renderGuide } from '../docs/guides';
import { REPO_BLOB } from '../docs/markdown';
import { getLibraryVersion } from '../docs/sizes';

const { html, headings } = renderGuide('theming');
const sections = headings
  .filter((heading) => heading.depth === 2)
  .map(({ id, text }) => ({ id, title: text }));
---

<AppLayout
  title="Theming"
  description="Light, dark and high contrast themes and right to left in WaveUI, and how to set brand colors and override its tokens."
  current="guide:theming"
  status={{ version: getLibraryVersion() }}
>
  <GuideArticle title="Theming" sections={sections}>
    <Fragment set:html={html} />
    <p>
      Every color token's value in each theme is listed in the README's
      <a href={`${REPO_BLOB}README.md#color-tokens`}>Color tokens</a> section on GitHub.
    </p>
  </GuideArticle>
</AppLayout>
